# O arquivo .env é criado sozinho na primeira execução, com segredos aleatórios.
# Este exemplo vale para rodar no computador. Para produção, veja o README.md.

# desenvolvimento libera os simuladores de e-mail e de WhatsApp. Em produção, use: producao
AMBIENTE=desenvolvimento
PORT=3100
APP_TIMEZONE=America/Sao_Paulo
# Endereço público do app, sem barra no final. Aparece nos links enviados por e-mail.
APP_URL=http://localhost:3100
# Obrigatório em produção: cabeçalho em que o provedor informa o endereço do visitante. Ex. na Fly.io: fly-client-ip
CABECALHO_IP_CLIENTE=

# Gerados automaticamente. Não mude depois de ter usuários: isso derruba sessões e conexões com o Google.
SESSAO_SEGREDO=
CRIPTO_CHAVE=

# Sem DATABASE_URL, o app usa um banco embutido em data/pg, próprio para testes no computador.
# Em produção, use um PostgreSQL gerenciado.
DATABASE_URL=

# E-mail: obrigatório em produção, para cadastro, nova senha e lembretes.
# Sem SMTP em desenvolvimento, as mensagens aparecem na tela de entrada.
# Ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
# Ex.: Nuvexx <nao-responda@avisos.nuvexx.com.br>
EMAIL_REMETENTE=

# Cadastro
# false: só os e-mails em EMAILS_LIBERADOS conseguem criar conta (período de testes).
CADASTRO_ABERTO=true
EMAILS_LIBERADOS=
TESTE_GRATIS_DIAS=7
LIMITE_MENSAGENS_DIA=100
# Link da página de assinatura. Enquanto estiver vazio, o app avisa que ainda não está disponível.
ASSINATURA_URL=

# Dados que aparecem nos termos de uso e na política de privacidade. Obrigatórios para abrir o cadastro em produção.
EMPRESA_NOME=
EMPRESA_CNPJ=
EMPRESA_EMAIL=

# WhatsApp (opcional, API oficial da Meta). Passo a passo no README.md.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número do app, com DDI e DDD. Sem ele, a opção de conectar o WhatsApp não aparece em produção. Ex.: 5547999998888
WHATSAPP_NUMERO_PUBLICO=
WHATSAPP_GRAPH_VERSION=v26.0
# Modelo aprovado na Meta para lembretes fora da janela de 24 horas. Texto no README.md.
WHATSAPP_MODELO_LEMBRETE=
# Modelo aprovado na Meta para o resumo do dia, enviado às 5h30. Texto no README.md.
WHATSAPP_MODELO_RESUMO=

# Áudio no WhatsApp (opcional). Sem a chave, um áudio recebe o aviso para mandar escrito. Passo a passo no README.md.
TRANSCRICAO_CHAVE=
# Precisa aceitar o formato OGG, usado nas mensagens de voz. O padrão é a Groq, com o modelo whisper-large-v3.
# TRANSCRICAO_URL=https://api.groq.com/openai/v1
# TRANSCRICAO_MODELO=whisper-large-v3

# Google (opcional): "Continuar com o Google" e envio ao Google Agenda. Passo a passo no README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
