# Para rodar no computador, copie para um arquivo .env nesta pasta. Nada daqui é compartilhado com o app.
# Na Fly.io, estes valores vêm do fly.toml e de "fly secrets set": veja o README.md.

# Em produção, use: producao. A página se recusa a abrir sem os dados da empresa, CABECALHO_IP_CLIENTE e PASTA_DADOS.
AMBIENTE=desenvolvimento
PORT=3200

# Cabeçalho em que o provedor informa o endereço do visitante. Ex. na Fly.io: fly-client-ip
CABECALHO_IP_CLIENTE=

# Pasta onde fica o inscritos.csv. Vazio: a pasta dados, aqui dentro. Só em desenvolvimento.
# No servidor, aponte para um disco permanente, para a lista não sumir ao publicar de novo.
PASTA_DADOS=

# Aparecem na política de privacidade da fila.
EMPRESA_NOME=
EMPRESA_CNPJ=
EMPRESA_EMAIL=contato@nuvexx.com.br
